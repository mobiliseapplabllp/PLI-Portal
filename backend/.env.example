PORT=5100
NODE_ENV=development

# MySQL (create database first — see deploy/mysql-init.example.sql)
MYSQL_HOST=10.26.1.84
MYSQL_PORT=3306
MYSQL_DATABASE=pli_portal
MYSQL_USER=mysql_admin
MYSQL_PASSWORD=Welcome@12345#@!
# MYSQL_SSL=true
# MYSQL_LOGGING=true

JWT_SECRET=your_jwt_secret_here_change_in_production
JWT_EXPIRES_IN=24h
JWT_REFRESH_SECRET=your_refresh_secret_here
JWT_REFRESH_EXPIRES_IN=7d
UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880

# SMTP — required. Sign-in is email-OTP only, so without these nobody can log in.
SMTP_HOST=mail.example.com
SMTP_PORT=587
SMTP_USER=noreply@example.com
SMTP_PASS=change-me
# Display name shown to recipients; defaults to "Lakshya Portal <SMTP_USER>" if unset
SMTP_FROM=Lakshya Portal <noreply@example.com>

# Used to build links in emails (OTP, roster, billing)
FRONTEND_URL=https://lakshya.onmobilise.com

# Comma-separated CORS allow-list; empty means same-origin only
CORS_ORIGINS=
